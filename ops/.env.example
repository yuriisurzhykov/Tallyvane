# The shape of the .env that lives on the server, in the deployment directory. This example
# is tracked; the real file is not, and `rsync --delete` in deploy.sh leaves it alone — it is
# the one exception, so that a `docker compose ps` typed by hand on the server still resolves
# every variable.
#
# Copy to .env on the server and fill in. Nothing here is read at build time; compose reads
# it when it starts the services.

# The zone in Cloudflare. nginx builds its three server names from it, and the tunnel builds
# its three ingress hostnames.
DOMAIN=example.com

# The tunnel's own identifier, printed by `cloudflared tunnel list`. Not a secret: the secret
# is the credentials file it names, which never leaves the server.
TUNNEL_ID=00000000-0000-0000-0000-000000000000

# PostgreSQL's password for the tallyvane role. Generate it, never type it — for example
# `openssl rand -base64 32`. Compose refuses to start if it is missing rather than falling
# back to something a reader of this repository would already know.
#
# The server and the migration command read it as TALLYVANE_DB_PASSWORD, mapped from here in
# docker-compose.yml rather than written twice.
POSTGRES_PASSWORD=

# The backend image to run. This is the version lever: changing it and deploying again is a
# release, and changing it back is a rollback, which is why the tag is explicit rather than
# `latest`. Locally it points at an image built by hand.
#
#   local:  tallyvane-backend:local
#   server: ghcr.io/<owner>/tallyvane-backend:v1.2.3
BACKEND_IMAGE=

# Opens the detailed health report at /api/v1/health to whoever presents it. At least 40
# characters, checked at startup: an absent token closes the report, a short one opens it to
# anybody willing to guess. `openssl rand -hex 32` gives 64.
TALLYVANE_HEALTH_TOKEN=

# TRACE, DEBUG, INFO, WARN or ERROR. Defaults to INFO when absent.
#TALLYVANE_LOG_LEVEL=INFO

# Where the tunnel credentials file sits. Overriding this is for a second deployment on one
# machine; the default in docker-compose.yml is the only path the provisioning scripts create.
#TUNNEL_CREDENTIALS=/srv/secrets/tallyvane/tunnel-credentials.json

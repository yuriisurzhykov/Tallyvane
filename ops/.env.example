# ----------------------------------------------------------------------------------------
# The shape of the .env that lives on the server, in the deployment directory. This example
# is tracked; the real file is not, and `rsync --delete` in deploy.sh leaves it alone — it is
# the one exception, so that a `docker compose ps` typed by hand on the server still resolves
# every variable.
#
# Copy to .env on the server and fill in. Nothing here is read at build time; compose reads
# it when it starts the services.
# ----------------------------------------------------------------------------------------

# The Cloudflare zone this deployment lives under. nginx builds its three server names from
# it (bare, app., admin.), and the tunnel builds its three ingress hostnames the same way.
#
# Value: the domain registered for this deployment, exactly as it appears in the Cloudflare
# dashboard for this account — nothing to generate, look it up there if unsure.
DOMAIN=example.com

# Identifies which Cloudflare Tunnel cloudflared should run. Not a secret itself — the secret
# is the credentials file this ID points to, which never leaves the server.
#
# Value: printed by `cloudflared tunnel list`, or by `cloudflared tunnel create <name>` the
# first time one is made (the tunnel provisioning step does this for you).
TUNNEL_ID=00000000-0000-0000-0000-000000000000

# PostgreSQL's password for the tallyvane role, read by `db` and, as TALLYVANE_DB_PASSWORD, by
# `app`/`migrate`. Required — compose refuses to start without it, rather than falling back to
# something a reader of this repository would already know.
#
# Value: never typed by hand — generate one, on the server, right before pasting it below:
#
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# The backend image `app` and `migrate` run, both colours. This is the version lever: changing
# it and rolling out is a release; changing it back is a rollback, which is why the tag is
# explicit rather than `latest`.
#
# Value: a tag already published to ghcr.io by a `v*` release. deploy-wrapper.sh writes this
# for you on every release after the first; only the first ever needs it typed by hand.
#
#   local:  tallyvane-backend:local
#   server: ghcr.io/<owner>/tallyvane-backend:v1.2.3
BACKEND_IMAGE=

# The same version lever, once per frontend application — independent tags (ADR-065's
# deployment consequence): a change to one never forces a rebuild or a redeploy of the other
# two. Same value source as BACKEND_IMAGE above, one `frontend-*-v*` release per line below.
#
#   server: ghcr.io/<owner>/tallyvane-frontend-web:frontend-web-v1.0.0
FRONTEND_WEB_IMAGE=
#   server: ghcr.io/<owner>/tallyvane-frontend-app:frontend-app-v1.0.0
FRONTEND_APP_IMAGE=
#   server: ghcr.io/<owner>/tallyvane-frontend-admin:frontend-admin-v1.0.0
FRONTEND_ADMIN_IMAGE=

# Opens the detailed health report at /api/v1/health to whoever presents it, checked by `app`
# at startup. Required, at least 40 characters — an absent token closes the report, a short
# one opens it to anybody willing to guess.
#
# Value: same idea as POSTGRES_PASSWORD above, hex for the extra length:
#
#   openssl rand -hex 32
TALLYVANE_HEALTH_TOKEN=

# app's log verbosity, read once at startup. Optional — absent means INFO.
#
# Value: one of TRACE, DEBUG, INFO, WARN, ERROR — pick one, nothing to generate.
#TALLYVANE_LOG_LEVEL=INFO

# Where cloudflared reads its tunnel credentials file. Optional — the default is the only path
# the provisioning step actually creates; override it only for a second deployment sharing
# this machine.
#
# Value: not generated, produced. `cloudflared tunnel create <name>` (after `tunnel login`)
# writes it to `~/.cloudflared/<tunnel-id>.json`; the 'tunnel' provisioning step installs it
# to this exact path for you.
#TUNNEL_CREDENTIALS=/srv/secrets/tallyvane/tunnel-credentials.json

# Which colour of each blue/green pair nginx currently sends traffic to, read by apply.sh and
# by nginx's own template. Optional — absent means blue. Not meant for hand-editing outside a
# disaster-recovery bring-up: apply.sh --rollout <service> writes these itself, at the moment
# it cuts traffic over, so a fresh apply.sh (no arguments) reproduces the true current state.
#
# Value: never typed — apply.sh sets it. Leave absent on a fresh server.
#APP_ACTIVE_COLOR=blue
#FRONTEND_WEB_ACTIVE_COLOR=blue
#FRONTEND_APP_ACTIVE_COLOR=blue
#FRONTEND_ADMIN_ACTIVE_COLOR=blue

# Where every service's OpenTelemetry sends spans — the Java agent on `app` (ADR-067) and
# @vercel/otel on each of the three frontends, all four pointed at the same Grafana Cloud
# project. Required — compose refuses to start a service rather than silently exporting
# nowhere.
#
# Value: from Grafana Cloud's OpenTelemetry "Minimal setup" wizard (pick "Use an existing
# token" if you already have one) — it hands you both lines ready to paste. Reformat any
# literal space inside HEADERS as %20; an unquoted space is not guaranteed to survive
# compose's own parsing of this file.
#
#   endpoint: https://otlp-gateway-<region>.grafana.net/otlp
#   headers:  Authorization=Basic%20<base64 of instance-id:api-token>
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

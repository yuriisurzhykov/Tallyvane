# The console. A separate server block rather than a path inside the site, because that is
# what the deployment actually is: frontend-web serves this hostname, and /api/* on it goes
# to the Ktor server (ARCHITECTURE.md §16, ADR-032).
server {
    listen 80;
    server_name app.${TALLYVANE_DOMAIN};

    access_log /var/log/nginx/access.log tallyvane;

    root /srv/www/app;
    index index.html;

    location /api/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
    }
}

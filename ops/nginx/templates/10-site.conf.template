# The public site. Serves a placeholder for now: the real landing page belongs to
# frontend-web, which has no image yet, and putting it in nginx would mean building something
# that has to be taken out again.
server {
    listen 80;
    server_name ${TALLYVANE_DOMAIN};

    access_log /var/log/nginx/access.log tallyvane;

    root /srv/www/site;
    index index.html;
}

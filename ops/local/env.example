# The same names as the server's `.env` (../.env.example); only the values differ.
# Copy to `.env` in this directory (git ignores it) and fill in the two Google lines.

# Two lines that exist only here: the address in the browser, and no collector to report to.
DOMAIN=tallyvane.localhost
APP_ORIGIN=http://localhost:8080
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=none=none

# Built from this checkout by ./stand.sh (names are yours to choose).
BACKEND_IMAGE=tallyvane-server:local
FRONTEND_WEB_IMAGE=tallyvane-frontend-web:local
FRONTEND_APP_IMAGE=tallyvane-frontend-app:local
FRONTEND_ADMIN_IMAGE=tallyvane-frontend-admin:local

# Throwaway values for a database that lives in a Docker volume on your machine.
POSTGRES_PASSWORD=local-only-password
TALLYVANE_HEALTH_TOKEN=local-only-health-token-at-least-forty-characters-long
TOKEN_PEPPER=local-only-pepper-at-least-thirty-two-characters-long
TOKEN_PEPPER_VERSION=1

# The OAuth client from https://console.cloud.google.com/apis/credentials, type "Web application",
# with the authorised redirect URI  http://localhost:8080/api/v1/google-return
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

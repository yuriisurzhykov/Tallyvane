{
  "name": "tallyvane-frontend-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:visual": "playwright test --project=desktop --project=tablet --project=mobile visual.spec.ts",
    "test:visual:update": "playwright test --update-snapshots visual.spec.ts",
    "test:a11y": "playwright test --project=desktop a11y.spec.ts",
    "test:contrast": "playwright test --project=desktop contrast-wcag.spec.ts contrast-apca.spec.ts",
    "test:contrast:wcag": "playwright test --project=desktop contrast-wcag.spec.ts",
    "test:contrast:apca": "playwright test --project=desktop contrast-apca.spec.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "arch": "pnpm run tokens:check && pnpm run arch:fsd && pnpm run arch:graph",
    "arch:fsd": "steiger ./src",
    "arch:graph": "depcruise app src scripts --config .dependency-cruiser.cjs",
    "graph": "depcruise app src --config .dependency-cruiser.cjs --output-type dot",
    "tokens:generate": "tsx scripts/generate-design-tokens.ts",
    "tokens:check": "tsx scripts/generate-design-tokens.ts --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "apca-w3": "^0.1.9",
    "colorparsley": "^0.1.8",
    "dependency-cruiser": "^18.2.0",
    "design-token-engine": "workspace:*",
    "postcss": "^8.5.26",
    "steiger": "^0.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^5"
  },
  "//": "design-token-engine is a devDependency on purpose: the compiler is build-time only and must never reach a bundle. Runtime consumers read the generated output instead. frontend-shared and content-kit are regular dependencies: their theme, api, i18n and block-rendering code IS the runtime bundle, for both this app and frontend-admin.",
  "dependencies": {
    "content-kit": "workspace:*",
    "frontend-shared": "workspace:*",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}

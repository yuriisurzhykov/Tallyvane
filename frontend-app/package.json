{
  "name": "tallyvane-frontend-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "arch": "pnpm run tokens:check && pnpm run arch:fsd && pnpm run arch:graph",
    "arch:fsd": "steiger ./src",
    "arch:graph": "depcruise app src scripts --config .dependency-cruiser.cjs",
    "graph": "depcruise app src --config .dependency-cruiser.cjs --output-type dot",
    "tokens:generate": "tsx scripts/generate-design-tokens.ts",
    "tokens:check": "tsx scripts/generate-design-tokens.ts --check"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dependency-cruiser": "^18.2.0",
    "design-token-engine": "workspace:*",
    "postcss": "^8.5.26",
    "steiger": "^0.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^5"
  },
  "//": "design-token-engine is a devDependency on purpose: the compiler is build-time only. frontend-shared is a regular dependency: its theme, api-client and i18n code IS the runtime bundle. content-kit is deliberately absent — see ARCHITECTURE.md §12.5's open question; add it back the day a real content-block scenario exists here, not before.",
  "dependencies": {
    "frontend-shared": "workspace:*",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}

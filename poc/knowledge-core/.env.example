# Copy to .env and fill in the two required values. .env is not committed.
# `./gradlew run` reads it from this directory; real environment variables win over it.
# docker compose reads EMBED_MODEL from it too.

# Required.
ANTHROPIC_API_KEY=
# Any model id the Anthropic Messages API accepts.
LLM_MODEL=claude-sonnet-5-5

# Postgres from docker-compose.yml. Change all three together with the compose file if you use another database.
DATABASE_URL=jdbc:postgresql://localhost:5432/knowledge
DATABASE_USER=knowledge
DATABASE_PASSWORD=knowledge

# Embeddings from Ollama. EMBED_DIM must be the size of the model's vectors (768 for nomic-embed-text).
# The size is fixed in the database the first time the application starts; changing it later needs a fresh database.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# How alike two actions must be (cosine, 0 to 1) to ask whether they are the same, and for a skill to be tagged.
DEDUPE_THRESHOLD=0.85
TAG_THRESHOLD=0.55

# Optional. A directory of prompts (extract.md, tags.md, bullets.md, vacancy.md) read on every call, so edits apply
# to the next answer without a restart. Empty: infra/src/main/resources/prompts when run from this directory.
PROMPTS_DIR=
# Optional. Another host for the Anthropic API (a proxy or a stub).
ANTHROPIC_URL=https://api.anthropic.com
PORT=8080

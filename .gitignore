# ---------- Environment and secrets ----------
# Never commit real values. `.env.example` documents the shape and IS tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# ---------- Local runtime artefacts ----------
*.log
tmp/
.cache/

# ---------- Deliberately NOT ignored ----------
# frontend/src/shared/ui/theme/generated/  — compiled design tokens are committed
#   on purpose; `tokens:check` verifies they match a fresh compile.
# docs/openapi.yaml                        — the API contract is a source, not an output.

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editors ----------
.idea/
*.iml
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- Gradle / JVM ----------
.gradle/
build/
out/
*.class
*.hprof
local.properties

# ---------- Node ----------
node_modules/
.next/
.turbo/
dist/
coverage/
*.tsbuildinfo
.npm/
.pnpm-store/

# ---------- Environment and secrets ----------
# Never commit real values. `.env.example` documents the shape and IS tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# ---------- Local runtime artefacts ----------
*.log
tmp/
.cache/

# ---------- Generated deployment files ----------
# Produced from ops/cloudflared/config.yml.template during deployment. Committing it would
# put a second, stale copy of the ingress rules next to the template that defines them.
ops/cloudflared/config.yml

# ---------- Deliberately NOT ignored ----------
# packages/frontend-shared/src/shared/ui/theme/generated/  — compiled design
#   tokens are committed on purpose; `tokens:check` verifies they match a
#   fresh compile.
# docs/openapi.yaml                        — the API contract is a source, not an output.

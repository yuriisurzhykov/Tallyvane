# ---------- Node ----------
node_modules/

# Storybook's own build output — regenerated by `build-storybook`, never
# hand-edited, and disposable the same way `.next/` is.
storybook-static/

# Playwright output. The baselines under tests/visual-snapshots ARE committed —
# they are the expected result — but the diffs, traces and reports a run
# produces are not.
test-results/
playwright-report/
blob-report/
.playwright/

*.tsbuildinfo
.npm/
.pnpm-store/

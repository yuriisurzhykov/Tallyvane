{
  "name": "tallyvane-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Showcase for Tier 0+ reusable components. Imports frontend-shared today; will also read stories from frontend-web/src and frontend-admin/src once those layers have Tier 3+ components of their own. See docs/frontend/02-component-testing-architecture.md for why this is its own package rather than living inside frontend-shared.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test:a11y": "node ./scripts/ensure-storybook-static.mjs && playwright test --project=desktop a11y.spec.ts",
    "test:contrast": "node ./scripts/ensure-storybook-static.mjs && playwright test --project=desktop contrast-wcag.spec.ts contrast-apca.spec.ts",
    "test:visual": "node ./scripts/ensure-storybook-static.mjs && playwright test --project=desktop --project=tablet --project=mobile visual.spec.ts",
    "test:visual:update": "node ./scripts/ensure-storybook-static.mjs && playwright test visual.spec.ts --update-snapshots",
    "test:e2e": "node ./scripts/ensure-storybook-static.mjs && playwright test",
    "test:scoped": "node ./scripts/ensure-storybook-static.mjs && node ../test-kit/src/cli/run-scoped.mjs --ports=6006,6007"
  },
  "dependencies": {
    "frontend-shared": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "test-kit": "workspace:*"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@storybook/react-vite": "^10.5.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "http-server": "^14.1.1",
    "postcss": "^8.5.26",
    "storybook": "^10.5.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}

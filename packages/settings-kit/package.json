{
  "name": "settings-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API-agnostic settings navigation, editing states, and composable UI shared by frontend applications.",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./entities/settings-item": "./src/entities/settings-item/index.ts",
    "./entities/settings-section": "./src/entities/settings-section/index.ts",
    "./features/settings-navigation": "./src/features/settings-navigation/index.ts",
    "./features/settings-toggle": "./src/features/settings-toggle/index.ts",
    "./widgets/settings-form": "./src/widgets/form-actions/index.ts",
    "./widgets/settings-group": "./src/widgets/group/index.ts",
    "./widgets/settings-workspace": "./src/widgets/workspace/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "arch": "pnpm run arch:fsd && pnpm run arch:graph",
    "arch:fsd": "steiger ./src",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "frontend-shared": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@react-buddy/ide-toolbox": "^2.5.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dependency-cruiser": "^18.2.0",
    "steiger": "^0.6.0",
    "typescript": "^5"
  }
}

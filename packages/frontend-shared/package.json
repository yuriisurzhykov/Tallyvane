  "scripts": {
    "typecheck": "tsc --noEmit",
    "arch": "pnpm run arch:fsd && pnpm run arch:graph",
    "arch:fsd": "steiger ./src",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run"
  },
  "//": "design-token-engine is a regular dependency, not dev: compiler.config.ts is imported (as data) from each consuming app's own tokens:generate script, which lives outside this package. @base-ui/react, lucide-react and the two @tanstack/* packages below are regular dependencies too, unlike the test tooling further down: components built on them ship in both apps' runtime bundles. @tanstack/react-table and @tanstack/react-virtual back DataTable (ADR-031's own named gap Base UI does not cover: a headless, virtualized table). @vercel/otel is a regular dependency for the opposite reason from the rest of this list — it never ships in the client bundle at all, only in each app's own instrumentation.ts, which Next.js runs server-side only; it lives here because the registration call itself (shared/lib/register-otel.ts) is identical for every app that calls it.",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@vercel/otel": "^2.1.3",
    "design-token-engine": "workspace:*",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@feature-sliced/filesystem": "^3.1.0",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@steiger/toolkit": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "^30.0.1",
    "steiger": "^0.6.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

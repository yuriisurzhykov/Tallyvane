{
  "name": "frontend-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The FSD `shared` layer, extracted from frontend-web/ so it can be a real dependency of both frontend-web (blog + console) and frontend-admin instead of code either of them could otherwise reach into. Ships zero business vocabulary — see ARCHITECTURE.md §12.5 and the `shared-has-no-domain` rule this package exists to keep true across two apps instead of one.",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "./ui/theme": "./src/shared/ui/theme/index.ts",
    "./ui/theme/tokens": "./src/shared/ui/theme/tokens/index.ts",
    "./ui/theme/compiler.config": "./src/shared/ui/theme/compiler.config.ts",
    "./ui/theme/*": "./src/shared/ui/theme/*",
    "./ui/logo": "./src/shared/ui/logo/index.ts",
    "./ui/text": "./src/shared/ui/text/index.ts",
    "./ui/dot": "./src/shared/ui/dot/index.ts",
    "./ui/keyboard-key": "./src/shared/ui/keyboard-key/index.ts",
    "./ui/visually-hidden": "./src/shared/ui/visually-hidden/index.ts",
    "./ui/field": "./src/shared/ui/field/index.ts",
    "./ui/fieldset": "./src/shared/ui/fieldset/index.ts",
    "./ui/surface": "./src/shared/ui/surface/index.ts",
    "./ui/separator": "./src/shared/ui/separator/index.ts",
    "./ui/scroll-area": "./src/shared/ui/scroll-area/index.ts",
    "./ui/aspect-ratio": "./src/shared/ui/aspect-ratio/index.ts",
    "./ui/grid": "./src/shared/ui/grid/index.ts",
    "./ui/stack": "./src/shared/ui/stack/index.ts",
    "./ui/row": "./src/shared/ui/row/index.ts",
    "./ui/numeric": "./src/shared/ui/numeric/index.ts",
    "./ui/truncate": "./src/shared/ui/truncate/index.ts",
    "./ui/icon-button": "./src/shared/ui/icon-button/index.ts",
    "./api": "./src/shared/api/index.ts",
    "./i18n": "./src/shared/i18n/index.ts",
    "./lib": "./src/shared/lib/index.ts",
    "./config": "./src/shared/config/index.ts",
    "./blocks": "./src/shared/blocks/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "arch": "pnpm run arch:fsd && pnpm run arch:graph",
    "arch:fsd": "steiger ./src",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run"
  },
  "//": "design-token-engine is a regular dependency, not dev: compiler.config.ts is imported (as data) from each consuming app's own tokens:generate script, which lives outside this package. @base-ui/react and lucide-react are regular dependencies too, unlike the test tooling below: components built on them ship in both apps' runtime bundles.",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "design-token-engine": "workspace:*",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "^30.0.1",
    "steiger": "^0.6.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
